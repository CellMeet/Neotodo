{
  "id": "ember-terminal",
  "name": "余烬终端",
  "englishName": "Ember Terminal",
  "version": "1.0.0",
  "description": "深色机房里的青色荧光和一点橙色余烬。附带更清脆的按键与翻页声，以及两张终端风格的成就图标。",
  "author": "NeoTodo",
  "license": "CC BY 4.0",
  "tags": ["dark", "terminal", "sound", "icons"],
  "theme": {
    "paper": "#0f1418",
    "paper2": "#171f24",
    "ink": "#d9f2e8",
    "muted": "#87a89b",
    "accent": "#4ee0a8",
    "accent2": "#ffb454",
    "border": "#294238",
    "stamp": "#4ee0a8",
    "glow": "rgba(78,224,168,.2)",
