# [linux] Desktop entry. Windows/Android have their own packaging.
[Desktop Entry]
Type=Application
Name=NeoTodo
GenericName=Weekly Postcard Todo
Comment=A quiet home for weekly focus and postcard memories
Exec=/home/arch/MyCode/NeoTodo/run.sh
Icon=/home/arch/MyCode/NeoTodo/icon-check.svg
Terminal=false
Categories=Utility;
StartupWMClass=io.github.neotodo
StartupNotify=true
Actions=NewWindow;

[Desktop Action NewWindow]
Name=New Window
Exec=/home/arch/MyCode/NeoTodo/run.sh --new-window
Icon=/home/arch/MyCode/NeoTodo/icon-check.svg
