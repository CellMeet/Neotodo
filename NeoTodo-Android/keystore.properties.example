# Copy to keystore.properties and fill in. keystore.properties and the .jks
# are git-ignored — back the keystore up, losing it locks the app on Google Play.
#
# storeFile paths are relative to the NeoTodo-Android folder.
storeFile=neotodo-upload.jks
storePassword=change-me
keyAlias=neotodo
keyPassword=change-me
